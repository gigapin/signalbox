# Identify the local application without providing production credentials.
APP_NAME=Signalbox
# Select local diagnostics; production must set production and disable debug.
APP_ENV=local
# Generate a private value with php artisan key:generate after copying this file.
APP_KEY=
# Enable detailed errors only for local development.
APP_DEBUG=true
# Match the local PHP development server address.
APP_URL=http://127.0.0.1:8000
# Select the initial UI locale.
APP_LOCALE=en
# Fall back to English for missing translations.
APP_FALLBACK_LOCALE=en
# Generate English-language synthetic data.
APP_FAKER_LOCALE=en_US
# Use filesystem maintenance markers until distributed infrastructure is configured.
APP_MAINTENANCE_DRIVER=file
# Write application diagnostics to the local stack.
LOG_CHANNEL=stack
# Select a single local log file as the stack destination.
LOG_STACK=single
# Include debug messages during local bootstrap.
LOG_LEVEL=debug
# Use the required PostgreSQL driver; no database is created automatically.
DB_CONNECTION=pgsql
# Host-mode address; Compose overrides this with its internal postgres service.
DB_HOST=127.0.0.1
# Select the PostgreSQL TCP port.
DB_PORT=5432
# Name the local application database provisioned by Compose.
DB_DATABASE=signalbox
# Name the local database account; set a private password only in .env.
DB_USERNAME=signalbox
# Set a private non-empty local password before starting Docker.
DB_PASSWORD=
# Host mode uses local session files; Compose overrides this with Redis.
SESSION_DRIVER=file
# Expire local sessions after 120 minutes.
SESSION_LIFETIME=120
# Host mode uses disk cache; Compose overrides this with Redis.
CACHE_STORE=file
# Host bootstrap runs jobs inline; Compose uses a separate Redis worker.
QUEUE_CONNECTION=sync
# Keep host bootstrap offline; choose reverb only after configuring its listener.
BROADCAST_CONNECTION=log
# Use the default private local filesystem disk.
FILESYSTEM_DISK=local
# Use the portable Redis client selected in M0.01.
REDIS_CLIENT=predis
# Host-mode address; Compose overrides this with its internal redis service.
REDIS_HOST=127.0.0.1
# Leave local Redis authentication unset until infrastructure provisioning.
REDIS_PASSWORD=null
# Select the Redis TCP port.
REDIS_PORT=6379
# Reserve database zero for the default Redis connection.
REDIS_DB=0
# Keep cached values separate in Redis database one.
REDIS_CACHE_DB=1
# Log mail locally rather than contacting an external provider.
MAIL_MAILER=log
# Use a reserved example domain for local sender identity.
MAIL_FROM_ADDRESS=hello@signalbox.example
# Display the configured product name as the mail sender.
MAIL_FROM_NAME="${APP_NAME}"
# Scout is fixed to the PostgreSQL database engine; searchable domain models arrive in M2.

# Publish the Docker web server on this loopback port.
APP_PORT=8000
# Match the host user and group IDs for bind-mounted generated files.
LOCAL_UID=1000
LOCAL_GID=1000
# Publish the optional local WebSocket server on this loopback port.
REVERB_FORWARD_PORT=8080
# Optional pgAdmin (dbadmin profile): local login and loopback port; leave empty unless you use it.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
# Supply local application credentials before enabling the realtime profile.
REVERB_APP_ID=signalbox-local
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Prefix queue metadata independently from application cache keys.
HORIZON_PREFIX=signalbox_horizon:
# Browser origin hostnames accepted by Reverb; do not include schemes, ports or wildcard hosts.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
# Host-mode backend publishing coordinates; Compose overrides them with internal service DNS.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser coordinates are separate from Compose's internal publishing host; blank host uses the page hostname.
REVERB_BROWSER_HOST=
REVERB_BROWSER_PORT=8080
REVERB_BROWSER_SCHEME=http
# Maximum bearer-token age in minutes; explicit per-token expiry can shorten it.
SANCTUM_EXPIRATION=1440
# Leave Stripe credentials empty for offline development; only pk_test_ and sk_test_ keys are accepted.
STRIPE_KEY=
STRIPE_SECRET=
# Reserve a test endpoint signing secret for M9; no webhook is registered yet.
STRIPE_WEBHOOK_SECRET=
# Format synthetic billing amounts in euros with English locale until billing settings are introduced.
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=en

# Comma-separated CIDR ranges that outbound checks and webhooks may reach despite the private-network block; keep empty in production.
OUTBOUND_ALLOWED_CIDRS=

# Enable only after the real CheckWorkConsumer runner is integrated; disabled by default.
MONITOR_SCHEDULING_ENABLED=false
