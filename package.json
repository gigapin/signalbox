{
  "name": "signalbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Signalbox React interface and asset build dependencies.",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@inertiajs/react": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "laravel-vite-plugin": "^3.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.2",
    "vite": "^8.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "types:check": "tsc --noEmit",
    "lint": "eslint resources/js vite.config.ts eslint.config.js prettier.config.js scripts --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write resources/js resources/css \"*.{js,ts}\" package.json tsconfig.json \"scripts/**/*.mjs\"",
    "format:check": "prettier --check resources/js resources/css \"*.{js,ts}\" package.json tsconfig.json \"scripts/**/*.mjs\"",
    "test:quality": "node --test scripts/quality.test.mjs",
    "check": "npm run lint && npm run format:check && npm run types:check && npm run test:quality"
  }
}
