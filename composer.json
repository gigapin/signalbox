{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "signalbox/signalbox",
    "type": "project",
    "description": "Multi-tenant application monitoring and public status pages.",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-bcmath": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-posix": "*",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.0",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.0",
        "predis/predis": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.0",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "dev": "@php artisan serve --host=127.0.0.1",
        "test": "@php vendor/bin/pest",
        "format": "@php vendor/bin/php-cs-fixer fix",
        "format:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
        "verify": [
            "@format:check --sequential",
            "@analyse --debug",
            "@test"
        ]
    }
}
