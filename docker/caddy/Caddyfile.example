# Deployment template only: TLS and the public ingress are enabled deliberately during M12.
# Security headers (CSP, HSTS, framing, nosniff) come from the application; see docs/SECURITY-HEADERS.md.
{
	# Supply an operational ACME account email and keep Caddy's certificate storage persistent.
	email {$ACME_EMAIL}

	# The backend must be private/loopback; this endpoint performs only an indexed ownership lookup.
	on_demand_tls {
		ask http://127.0.0.1:9123/internal/status-domains/allow
	}

	# Prevent serving an HTTP Host different from the TLS handshake's SNI name.
	servers {
		strict_sni_host on
	}
}

# The primary account application has its own explicitly configured hostname/certificate.
{$APP_HOST} {
	# TLS admission is internal even when an external client reaches the primary application.
	@internal path /internal/status-domains/* /index.php*
	respond @internal 404
	reverse_proxy 127.0.0.1:8000 {
		header_up Host {http.request.hostport}
		header_up -SignalboxTlsSecret
	}
}

# Only names admitted by the application can trigger on-demand certificate management.
https:// {
	tls {
		on_demand
	}
	@internal path /internal/status-domains/* /index.php*
	respond @internal 404
	reverse_proxy 127.0.0.1:8000 {
		header_up Host {http.request.hostport}
		header_up -SignalboxTlsSecret
	}
}

# Only the on-demand ask client uses this loopback listener; never publish this port.
http://127.0.0.1:9123 {
	bind 127.0.0.1
	@admission {
		method GET HEAD
		path /internal/status-domains/allow
	}
	handle @admission {
		reverse_proxy 127.0.0.1:8000 {
			# Runtime expansion keeps a missing secret empty, which Laravel refuses.
			header_up SignalboxTlsSecret {env.STATUS_DOMAIN_TLS_SECRET}
		}
	}
	handle {
		respond 404
	}
}
